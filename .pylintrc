[MASTER]
ignore=CVS
persistent=yes
load-plugins=
jobs=1
unsafe-load-any-extension=no

[MESSAGES CONTROL]
disable=
    too-many-branches,
    too-many-locals,
    too-many-statements,
    too-many-lines,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    too-many-nested-blocks,
    missing-docstring,
    invalid-name,
    line-too-long,
    broad-exception-caught,
    subprocess-run-check,
    attribute-defined-outside-init,
    reimported,
    unused-import,
    unused-argument,
    unused-variable,
    wrong-import-order,
    wrong-import-position,
    redefined-outer-name,
    protected-access,
    consider-using-with,
    too-many-boolean-expressions,
    global-statement,
    import-outside-toplevel,
    unspecified-encoding,
    no-else-return,
    superfluous-parens,
    expression-not-assigned,

[REPORTS]
output-format=text
reports=no
score=yes
