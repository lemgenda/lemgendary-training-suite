  "components": {
    "schemas": {
      "EvalRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Target model key"
          },
          "checkpoint_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpoint Path",
            "description": "Path to checkpoint (.pth)"
          },
          "batch_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Size",
            "description": "Evaluation batch size"
          },
          "env": {
            "type": "string",
            "title": "Env",
            "description": "Environment",
            "default": "local"
          }
        },
        "type": "object",
        "required": [
          "model"
        ],
        "title": "EvalRequest",
        "description": "Payload for submitting evaluation job."
      },
      "ExportRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Target model key"
          },
          "checkpoint_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpoint Path",
            "description": "Path to checkpoint"
          },
          "output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Dir",
            "description": "Export output directory"
          },
          "targets": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Targets",
            "description": "Subset of export targets"
          }
        },
        "type": "object",
        "required": [
          "model"
        ],
        "title": "ExportRequest",
        "description": "Payload for submitting export job."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuickTrainRequest": {
        "properties": {
          "model_key": {
            "type": "string",
            "title": "Model Key",
            "description": "Target model key"
          },
          "preset": {
            "type": "string",
            "title": "Preset",
            "description": "Preset name from presets.yaml",
            "default": "quick-sota"
          },
          "clean": {
            "type": "boolean",
            "title": "Clean",
            "description": "Wipe checkpoints and start fresh",
            "default": false
          },
          "epochs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Epochs",
            "description": "Optional override for training epochs"
          },
          "batch_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Size",
            "description": "Optional override for batch size"
          },
          "learning_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Learning Rate",
            "description": "Optional override for learning rate"
          },
          "env": {
            "type": "string",
            "title": "Env",
            "description": "Execution environment ('local', 'kaggle', 'colab')",
            "default": "local"
          }
        },
        "type": "object",
        "required": [
          "model_key"
        ],
        "title": "QuickTrainRequest",
        "description": "Payload for quick train trigger."
      },
      "TrainRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Target model key"
          },
          "epochs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Epochs",
            "description": "Total epochs override"
          },
          "batch_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Size",
            "description": "Batch size override"
          },
          "lr": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lr",
            "description": "Learning rate override"
          },
          "preset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preset",
            "description": "Preset configuration name"
          },
          "env": {
            "type": "string",
            "title": "Env",
            "description": "Target environment ('local', 'kaggle', 'colab')",
            "default": "local"
          },
          "clean": {
            "type": "boolean",
            "title": "Clean",
            "description": "Wipe local checkpoints and start fresh",
            "default": false
          },
          "auto_sync": {
            "type": "boolean",
            "title": "Auto Sync",
            "description": "Auto sync checkpoints to cloud",
            "default": false
          },
          "parallel": {
            "type": "string",
            "title": "Parallel",
            "description": "Parallel strategy ('auto', 'single', 'dp', 'ddp')",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "model"
        ],
        "title": "TrainRequest",
        "description": "Payload for submitting training job."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
